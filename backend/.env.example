# ── App ──
APP_ENV=production
APP_SECRET_KEY=change-me-to-a-random-64-char-string
CORS_ORIGINS=http://localhost:5173
MAX_UPLOAD_SIZE_MB=10
LOG_LEVEL=INFO

# ── Demo mode ──
# true  = no authentication, demo user, SYNTHETIC DATA ONLY
# false = OIDC (Azure AD) auth — configure the AZURE_* block below
DEMO_MODE=true

# ── AI provider ──
# gemini (default, free tier: https://aistudio.google.com/apikey) | azure_openai
AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# ── Database (app metadata / audit log) ──
# Default: local SQLite. For SQL Server sources, install aioodbc and use mssql+aioodbc://...
DATABASE_URL=sqlite+aiosqlite:///./data/mediextract.db

# ── Azure OpenAI (only if AI_PROVIDER=azure_openai) ──
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# ── Azure AD / OIDC (only if DEMO_MODE=false) ──
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_AUTHORITY=
