# ── App ──
APP_ENV=production
APP_SECRET_KEY=change-me-to-a-random-64-char-string
CORS_ORIGINS=http://localhost:5173
MAX_UPLOAD_SIZE_MB=10
LOG_LEVEL=INFO

# ── Demo mode ──
# true  = no authentication, demo user, SYNTHETIC DATA ONLY
# false = OIDC (Azure AD) auth — configure the AZURE_* block below
DEMO_MODE=true

# ── Clinical governance ──
# true = the person who ran an extraction may not sign it off; a second
# reviewer must. Off here because the demo has one user, and a rule nobody can
# satisfy teaches nothing. A governed deployment turns it on.
REQUIRE_SEPARATE_APPROVER=false

# ── AI provider ──
# gemini (default, free tier: https://aistudio.google.com/apikey) | azure_openai
AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key
# One API request is made per note, so a batch of 20 notes costs 20 requests.
# Free-tier request quotas are per-model and per-day, and the flash models have
# a much tighter one than the lite models — gemini-2.5-flash allows 20 requests
# a day, which a single demo session exhausts. Check your key's limits at
# https://ai.dev/rate-limit before changing this. Running out mid-demo is
# survivable — see AI_FALLBACK_MODELS below.
GEMINI_MODEL=gemini-3.5-flash

# Models to fall back to, in order, when the one above is rate limited.
# "provider:model", or a bare model name meaning AI_PROVIDER's provider.
# Quotas are counted per model, so a second model is a second quota — which is
# the point. On a 429 the extractor moves to the next entry and holds the
# exhausted model back: for the seconds Google asks for if it was a per-minute
# limit, until the quota resets if the daily one is spent. GET
# /api/v1/extraction/models shows the chain and what each model is doing.
# Entries whose provider has no credentials configured are dropped at startup.
AI_FALLBACK_MODELS=groq:openai/gpt-oss-120b,mistral:mistral-small-latest,gemini-3.1-flash-lite,gemini-2.5-flash

# ── Other free providers in the chain ──
# Both speak the OpenAI chat-completions API, both have a free tier without a
# card, and both state that API input is not used for training — which Google's
# free tier does not. Leave a key blank and that provider is dropped from the
# chain at startup, so the defaults above are safe unset.
# Groq: https://console.groq.com/keys   Mistral: https://console.mistral.ai/
GROQ_API_KEY=
MISTRAL_API_KEY=
# Only used when AI_PROVIDER points at them; the chain names its own models.
GROQ_MODEL=openai/gpt-oss-120b
MISTRAL_MODEL=mistral-small-latest

# Cooldown after a 429 that carried no delay of its own, and how long a request
# will wait for a model to free up before giving up with a 503.
AI_RATE_LIMIT_COOLDOWN_SECONDS=60
AI_MAX_WAIT_SECONDS=30

# ── Scanned documents ──
# A PDF with no text layer (a scan, or a photo saved as a PDF) is rendered to
# page images and read by a vision-capable model — the text-only models in the
# chain are skipped for those notes and used for everything else. Models are
# recognised by name; a vision model we do not know about goes here, as
# "provider:model", or it will be treated as text-only and never offered a
# scan. The default chain's Gemini entries are already vision-capable.
AI_VISION_MODELS=

# Rendering. 150 dpi is enough for printed clinical notes and keeps a page
# around 200 KB; the page cap is there because every page becomes base64 in a
# request and then tokens in a context window.
PDF_RENDER_DPI=150
PDF_RENDER_MAX_PAGES=8
PDF_RENDER_JPEG_QUALITY=80

# ── Database (app metadata / audit log) ──
# The app's own tables: audit log, extraction runs and rows, sign-off state,
# saved schemas. SQLite by default so a dev run needs no external service.
# The production compose file overrides this with its own Postgres instance
# (service `app-db`) — an audit trail on a single file is fine for a laptop and
# not what you would put in front of a governance review.
DATABASE_URL=sqlite+aiosqlite:///./data/mediextract.db

# ── Source notes database (the customer's clinical system) ──
# Read-only. Kept separate from DATABASE_URL because in a real deployment the
# notes live in a system we do not own. Any SQLAlchemy-supported engine works —
# the queries are built with SQLAlchemy Core, not raw dialect-specific SQL.
#   Postgres:    postgresql+asyncpg://user:pass@host:5432/dbname
#   SQL Server:  mssql+aioodbc://user:pass@host/dbname?driver=ODBC+Driver+18+for+SQL+Server
#   SQLite:      sqlite+aiosqlite:///./data/notes.db
# Leave blank to reuse DATABASE_URL (single-database dev setups).
NOTES_DATABASE_URL=postgresql+asyncpg://mediextract:CHANGEME@notes-db:5432/clinical_notes

# ── Azure OpenAI (only if AI_PROVIDER=azure_openai) ──
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# ── Azure AD / OIDC (only if DEMO_MODE=false) ──
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_AUTHORITY=
